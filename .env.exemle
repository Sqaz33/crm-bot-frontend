VITE_API_BASE=
VITE_DEV_HOST=

# Сохранять init data в localStorage (по умолчанию false - используется sessionStorage)
# true - разрешить localStorage, false - только sessionStorage (безопаснее)
# ВНИМАНИЕ: включение localStorage делает init data доступной через DevTools
VITE_SAVE_INIT_DATA_TO_STORAGE=false
